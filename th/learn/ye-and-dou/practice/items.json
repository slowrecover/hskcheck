{"items":[{"t":"c","x":0,"b":"我","a":"喜欢喝茶。","r":"也","o":["也","都"],"m":"ฉันก็ชอบดื่มชาเหมือนกัน"},{"t":"c","x":0,"b":"他们","a":"是学生。","r":"都","o":["也","都"],"m":"พวกเขาเป็นนักเรียนทุกคน"},{"t":"c","x":0,"b":"我爸爸和妈妈","a":"是医生。","r":"都","o":["也","都"],"m":"พ่อกับแม่ของฉันเป็นหมอทั้งคู่"},{"t":"c","x":0,"b":"我","a":"不想去。","r":"也","o":["也","都"],"m":"ฉันก็ไม่อยากไปเหมือนกัน"},{"t":"c","x":0,"b":"这些衣服","a":"很漂亮。","r":"都","o":["也","都"],"m":"เสื้อผ้าพวกนี้สวยทุกตัว"},{"t":"c","x":0,"b":"他会说汉语，","a":"会写汉字。","r":"也","o":["也","都"],"m":"เขาพูดภาษาจีนได้ และก็เขียนตัวอักษรจีนได้ด้วย"},{"t":"c","x":0,"b":"她很忙，我","a":"很忙。","r":"也","o":["也","都"],"m":"เธอยุ่ง ฉันก็ยุ่งเหมือนกัน"},{"t":"c","x":0,"b":"昨天我们","a":"没有去上课。","r":"都","o":["也","都"],"m":"เมื่อวานพวกเราไม่ได้ไปเรียนสักคน"},{"t":"o","x":1,"w":["是","中国人","我","也"],"r":["我也是中国人。"],"m":"ฉันก็เป็นคนจีนเหมือนกัน"},{"t":"o","x":1,"w":["去","我们","想","都"],"r":["我们都想去。"],"m":"พวกเราอยากไปกันทุกคน"},{"t":"o","x":1,"w":["不","他们","来","都"],"r":["他们都不来。"],"m":"พวกเขาไม่มาสักคน"},{"t":"o","x":1,"w":["喜欢","也","电影","她","看"],"r":["她也喜欢看电影。"],"m":"เธอก็ชอบดูหนังเหมือนกัน"},{"t":"o","x":1,"w":["都","老师","我们","是","也"],"r":["我们也都是老师。"],"m":"พวกเราก็เป็นครูทุกคนเหมือนกัน"},{"t":"o","x":1,"w":["没有","也","我","去","昨天"],"r":["我昨天也没有去。","昨天我也没有去。"],"m":"เมื่อวานฉันก็ไม่ได้ไปเหมือนกัน"},{"t":"f","x":2,"s":"也我是老师。","r":["我也是老师。"],"o":["我是也老师。","我是老师也。"],"m":"ฉันก็เป็นครูเหมือนกัน"},{"t":"f","x":2,"s":"我喜欢喝茶也。","r":["我也喜欢喝茶。"],"o":["我喜欢也喝茶。","也我喜欢喝茶。"],"m":"ฉันก็ชอบดื่มชาเหมือนกัน"},{"t":"f","x":2,"s":"都我们是中国人。","r":["我们都是中国人。"],"o":["我们是都中国人。","我们是中国人都。"],"m":"พวกเราเป็นคนจีนทุกคน"},{"t":"f","x":2,"s":"他不也会说汉语。","r":["他也不会说汉语。"],"o":["他不会也说汉语。","他不会说也汉语。"],"m":"เขาก็พูดภาษาจีนไม่ได้เหมือนกัน"},{"t":"f","x":2,"s":"他们都也是学生。","r":["他们也都是学生。"],"o":["他们是也都学生。","他们也是都学生。"],"m":"พวกเขาก็เป็นนักเรียนทุกคนเหมือนกัน"},{"t":"f","x":2,"s":"我都喜欢这两本书。","r":["这两本书我都喜欢。","我这两本书都喜欢。"],"o":["我喜欢都这两本书。","我喜欢这两本书都。"],"m":"ฉันชอบหนังสือสองเล่มนี้ทั้งคู่"}]}